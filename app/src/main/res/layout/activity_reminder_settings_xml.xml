<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/exBackground">
    <LinearLayout android:id="@+id/reminder_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:gravity="center_vertical" android:background="@drawable/settings_warning" android:visibility="gone">
        <ImageView android:id="@+id/reminder_banner_icon" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" />
        <TextView style="@style/SettingsText" android:layout_marginStart="8dp" android:text="Chưa hoạt động - Thiếu quyền thông báo" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:background="?attr/exSurface">
        <ImageView android:id="@+id/reminder_back" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:background="@drawable/settings_back" android:contentDescription="Quay lại" android:importantForAccessibility="yes" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/reminder_title" style="@style/SettingsText" android:text="Nhắc nhở tập luyện" android:textSize="20sp" android:layout_marginStart="16dp" android:textStyle="bold" android:lineHeight="25sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
    </LinearLayout>
    <ScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/reminder_permission" android:visibility="gone" android:padding="16dp" android:layout_marginBottom="24dp" android:background="@drawable/settings_permission_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:id="@+id/reminder_warning_icon" android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/reminder_warning_title" style="@style/SettingsText" android:text="Quyền thông báo bị tắt" android:textSize="16sp" android:layout_marginStart="12dp" android:textColor="#C2410C" android:textStyle="bold" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="16dp" />
                <TextView android:id="@+id/reminder_warning_message" style="@style/SettingsText" android:text="Ứng dụng không thể gửi lời nhắc tập luyện vì bạn đã chặn thông báo từ hệ thống. Hãy cấp quyền để duy trì thói quen tập luyện." android:textSize="14sp" android:textColor="?attr/settingsMuted" android:lineHeight="20sp" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
                <Space android:layout_width="1dp" android:layout_height="16dp" />
                <TextView android:id="@+id/reminder_system" style="@style/SettingsText" android:text="Mở cài đặt hệ thống" android:textSize="14sp" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/settings_primary" android:textColor="#FFFFFF" android:minHeight="52dp" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/settings_card">
                <TextView android:id="@+id/reminder_status_title" style="@style/SettingsText" android:text="Trạng thái nhắc nhở" android:textSize="18sp" android:textStyle="bold" android:lineHeight="23sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                <Space android:layout_width="1dp" android:layout_height="4dp" />
                <TextView android:id="@+id/reminder_status" style="@style/SettingsText" android:text="Đang tắt" android:textSize="14sp" android:textColor="#1E3A8A" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
                <Space android:layout_width="1dp" android:layout_height="16dp" />
                <ImageView android:id="@+id/reminder_toggle" android:layout_width="52dp" android:layout_height="32dp" android:importantForAccessibility="yes" android:contentDescription="Bật nhắc nhở" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:id="@+id/reminder_next_card" android:padding="16dp" android:background="@drawable/settings_card" android:layout_marginTop="16dp">
                <ImageView android:id="@+id/reminder_clock" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/reminder_next" style="@style/SettingsText" android:text="" android:textSize="14sp" android:layout_marginStart="12dp" android:textColor="?attr/settingsMuted" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
            </LinearLayout>
            <TextView android:id="@+id/reminder_heading_repeat" style="@style/SettingsText" android:text="TẦN SUẤT LẶP LẠI" android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/settingsMuted" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="4dp" android:background="@drawable/settings_card">
                <TextView android:id="@+id/reminder_daily" style="@style/SettingsText" android:text="Hằng ngày" android:textSize="14sp" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
                <TextView android:id="@+id/reminder_weekly" style="@style/SettingsText" android:text="Theo tuần" android:textSize="14sp" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
            </LinearLayout>
            <TextView android:id="@+id/reminder_heading_time" style="@style/SettingsText" android:text="THỜI GIAN NHẮC" android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/settingsMuted" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/settings_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/reminder_time" style="@style/SettingsText" android:text="18:30" android:textSize="48sp" android:layout_width="wrap_content" android:textStyle="bold" android:lineHeight="60sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 800" />
                    <TextView android:id="@+id/reminder_period" style="@style/SettingsText" android:text="PM" android:textSize="14sp" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textColor="?attr/settingsMuted" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="16dp" />
                <LinearLayout android:layout_height="wrap_content" android:gravity="center_vertical" android:id="@+id/reminder_edit" android:layout_width="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="@drawable/settings_primary" android:clickable="true" android:focusable="true">
                    <ImageView android:id="@+id/reminder_edit_icon" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/reminder_edit_label" style="@style/SettingsText" android:text="Thay đổi" android:textSize="13sp" android:layout_width="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textStyle="bold" android:fontFamily="@font/manrope" android:fontVariationSettings="'wght' 600" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/reminder_days" android:visibility="gone">
                <TextView android:id="@+id/reminder_heading_days" style="@style/SettingsText" android:text="CHỌN NGÀY TRONG TUẦN" android:textSize="15sp" android:textStyle="bold" android:textColor="?attr/settingsMuted" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/reminder_day_1" style="@style/SettingsText" android:text="T2" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                    <TextView android:id="@+id/reminder_day_2" style="@style/SettingsText" android:text="T3" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                    <TextView android:id="@+id/reminder_day_3" style="@style/SettingsText" android:text="T4" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                    <TextView android:id="@+id/reminder_day_4" style="@style/SettingsText" android:text="T5" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                    <TextView android:id="@+id/reminder_day_5" style="@style/SettingsText" android:text="T6" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                    <TextView android:id="@+id/reminder_day_6" style="@style/SettingsText" android:text="T7" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                    <TextView android:id="@+id/reminder_day_7" style="@style/SettingsText" android:text="CN" android:textSize="14sp" android:gravity="center" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:minHeight="44dp" android:padding="0dp" android:layout_marginHorizontal="2dp" android:background="@drawable/settings_day" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/reminder_save" style="@style/SettingsText" android:text="Lưu cài đặt" android:textSize="14sp" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/settings_primary" android:textColor="#FFFFFF" android:minHeight="52dp" android:textStyle="bold" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 700" />
    </LinearLayout>
    <View android:id="@+id/settings_inset" android:layout_width="match_parent" android:layout_height="0dp" />
</LinearLayout>
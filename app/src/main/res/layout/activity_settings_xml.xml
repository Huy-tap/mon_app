<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/exBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="17dp">
        <ImageView android:id="@+id/settings_back" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Quay lại" android:importantForAccessibility="yes" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/settings_title" style="@style/SettingsText" android:text="Cài đặt" android:textSize="22sp" android:layout_marginStart="12dp" android:textStyle="bold" android:lineHeight="30sp"/>
    </LinearLayout>
    <ScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="20dp">
            <TextView style="@style/SettingsHeading" android:text="Giao diện"/>
            <Space android:layout_width="1dp" android:layout_height="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@drawable/settings_card" android:padding="16dp">
                <TextView android:id="@+id/settings_light" style="@style/SettingsText" android:text="☀️ Sáng" android:textSize="14sp" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:background="@drawable/settings_selected"/>
                <TextView android:id="@+id/settings_dark" style="@style/SettingsText" android:text="🌙 Tối" android:textSize="14sp" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/settings_option"/>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="20dp"/>
            <TextView style="@style/SettingsHeading" android:text="Nhắc nhở tập luyện"/>
            <Space android:layout_width="1dp" android:layout_height="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/settings_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="4dp">
                    <ImageView android:id="@+id/settings_dot" android:layout_width="8dp" android:layout_height="8dp" android:importantForAccessibility="no"/>
                    <TextView android:id="@+id/settings_status_label" style="@style/SettingsText" android:text="Trạng thái" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium"/>
                    <TextView android:id="@+id/settings_status" style="@style/SettingsText" android:text="Chưa thiết lập" android:textSize="14sp" android:layout_width="wrap_content" android:maxWidth="190dp" android:gravity="end" android:textColor="?attr/settingsMuted"/>
                </LinearLayout>
                <TextView android:id="@+id/settings_warning" style="@style/SettingsText" android:text="⚠️ Quyền thông báo đang bị chặn" android:textSize="12sp" android:padding="10dp" android:layout_marginTop="14dp" android:background="@drawable/settings_warning" android:textColor="@color/warning_text" android:visibility="gone"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/settings_schedule_group">
                    <ImageView android:id="@+id/settings_line_schedule" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="13dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="4dp">
                        <TextView android:id="@+id/settings_schedule_label" style="@style/SettingsText" android:text="Lịch nhắc" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/settings_schedule" style="@style/SettingsText" android:text="" android:textSize="14sp" android:layout_width="wrap_content" android:maxWidth="190dp" android:gravity="end" android:textColor="?attr/settingsMuted"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/settings_next_group">
                    <ImageView android:id="@+id/settings_line_next" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="13dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="4dp">
                        <TextView android:id="@+id/settings_next_label" style="@style/SettingsText" android:text="Lần nhắc kế tiếp" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/settings_next" style="@style/SettingsText" android:text="" android:textSize="14sp" android:layout_width="wrap_content" android:maxWidth="190dp" android:gravity="end" android:textColor="?attr/settingsMuted"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/settings_system_group" android:visibility="gone">
                    <ImageView android:id="@+id/settings_line_system" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="13dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:id="@+id/settings_system" android:paddingVertical="4dp" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/settings_system_label" style="@style/SettingsText" android:text="Mở cài đặt hệ thống 🔗" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
                        <ImageView android:id="@+id/settings_system_chevron" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageView android:id="@+id/settings_line_setup" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="13dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:id="@+id/settings_setup" android:paddingVertical="4dp" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/settings_setup_label" style="@style/SettingsText" android:text="Thiết lập lịch nhắc" android:textSize="14sp" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
                    <ImageView android:id="@+id/settings_chevron" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/exOutline"/>
    <include layout="@layout/exercise_nav_xml"/>
    <View android:id="@+id/settings_inset" android:layout_width="match_parent" android:layout_height="0dp" android:background="?attr/exSurface"/>
</LinearLayout>

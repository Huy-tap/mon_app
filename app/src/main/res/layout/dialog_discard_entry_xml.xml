<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ex_dialog"
    android:padding="24dp">

    <!-- Tiêu đề: Bỏ bài khỏi phiếu? -->
    <TextView
        android:id="@+id/dialog_title"
        style="@style/ExText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bỏ bài khỏi phiếu?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/exText" />

    <Space
        android:layout_width="1dp"
        android:layout_height="12dp" />

    <!-- Nội dung mô tả -->
    <TextView
        android:id="@+id/dialog_message"
        style="@style/ExText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bài tập vẫn được giữ trong danh mục."
        android:textSize="14sp"
        android:lineHeight="20sp"
        android:textColor="?attr/exText" />

    <Space
        android:layout_width="1dp"
        android:layout_height="24dp" />

    <!-- Nút Bỏ bài (Primary, tối màu, ở trên) -->
    <TextView
        android:id="@+id/dialog_btn_discard"
        style="@style/ExPrimary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Bỏ bài"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="1dp"
        android:layout_height="12dp" />

    <!-- Nút Tiếp tục nhập / Giữ lại (Secondary, sáng màu, ở dưới) -->
    <TextView
        android:id="@+id/dialog_btn_continue"
        style="@style/ExButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/ex_pale"
        android:gravity="center"
        android:text="Giữ lại"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?attr/exText" />

</LinearLayout>

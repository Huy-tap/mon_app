<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- Card Ngày tập -->
        <LinearLayout
            android:id="@+id/record_date_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ex_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/record_date_label"
                style="@style/ExText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày tập"
                android:textSize="12sp"
                android:textColor="?attr/exMuted" />

            <Space
                android:layout_width="1dp"
                android:layout_height="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/record_date_text"
                    style="@style/ExText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="18/09/2026"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/record_date_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <!-- Card Trống: Chưa có kết quả bài tập (Ảnh 2) -->
        <LinearLayout
            android:id="@+id/record_empty_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/ex_card_dashed"
            android:paddingTop="36dp"
            android:paddingBottom="36dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/record_empty_title"
                style="@style/ExText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có kết quả bài tập"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center" />

            <Space
                android:layout_width="1dp"
                android:layout_height="6dp" />

            <TextView
                android:id="@+id/record_empty_subtitle"
                style="@style/ExText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hãy thêm bài bạn đã tập."
                android:textSize="13sp"
                android:textColor="?attr/exMuted"
                android:gravity="center" />
        </LinearLayout>

        <!-- Danh sách bài tập đã thêm vào phiếu (Ảnh 5) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/record_entries_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <!-- Nút + Thêm bài tập / + Chọn bài tập -->
        <TextView
            android:id="@+id/record_btn_add_exercise"
            style="@style/ExButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/ex_outline_button"
            android:text="＋ Thêm bài tập"
            android:textColor="?attr/exText"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <!-- Tóm tắt số bài và thời lượng -->
        <LinearLayout
            android:id="@+id/record_summary_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/record_summary_text"
                style="@style/ExText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 bài · 0 phút"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/record_summary_subtext"
                style="@style/ExText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa lưu vào lịch sử"
                android:textSize="12sp"
                android:textColor="?attr/exMuted"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Khoảng cách đàn hồi đẩy banner và nút lưu xuống chân màn hình nếu nội dung ngắn -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- Banner thông báo đã xóa bài tập khỏi phiếu (Ảnh 1 & Ảnh 2) -->
        <LinearLayout
            android:id="@+id/record_delete_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ex_primary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/record_delete_banner_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/exOnPrimary"
                android:textSize="13sp"
                android:textStyle="normal"
                android:text="Đã bỏ “Chống đẩy” khỏi phiếu · Còn 1 bài"
                android:gravity="center" />
        </LinearLayout>

        <!-- Nút Lưu buổi tập (ở cuối form hoặc footer) -->
        <TextView
            android:id="@+id/record_btn_save_workout"
            style="@style/ExPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Lưu buổi tập"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

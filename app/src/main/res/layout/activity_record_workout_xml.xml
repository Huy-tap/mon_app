<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/exBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/record_back"
                style="@style/ExText"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="‹"
                android:textSize="32sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại" />

            <TextView
                android:id="@+id/record_title"
                style="@style/ExText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="Ghi nhận buổi tập"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineHeight="30sp" />
        </LinearLayout>

        <!-- Main dynamic content container -->
        <FrameLayout
            android:id="@+id/record_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true" />

        <!-- Fixed Bottom Action Bar / Footer: Nút Lưu buổi tập luôn cố định ở đáy khi có bài tập -->
        <FrameLayout
            android:id="@+id/record_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:background="?attr/exBackground"
            android:visibility="gone">

            <TextView
                android:id="@+id/record_btn_save_footer"
                style="@style/ExPrimary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Lưu buổi tập"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- System navigation bar inset spacer -->
        <View
            android:id="@+id/record_bottom_inset"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/exBackground" />
    </LinearLayout>

    <!-- Popup nho nhỏ phía dưới nổi lên từ dưới lên trên (Ảnh 1 & Ảnh 2) -->
    <LinearLayout
        android:id="@+id/record_floating_toast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/ex_floating_toast_bg"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:gravity="center"
        android:elevation="14dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/record_floating_toast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="normal"
            android:text="Đã bỏ “Chống đẩy” khỏi phiếu · Còn 1 bài"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>

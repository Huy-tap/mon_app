<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="?attr/exBackground">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true"
            android:clipToPadding="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="20dp"
                android:paddingTop="10dp" android:paddingBottom="20dp">
                <TextView style="@style/HomeText" android:text="Trang chủ" android:textSize="26sp"
                    android:lineHeight="36.4sp" android:minHeight="36.4sp" android:textStyle="bold"/>
                <TextView android:id="@+id/home_date" style="@style/HomeSmall"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:orientation="vertical" android:padding="16dp"
                    android:background="@drawable/home_hero">
                    <TextView style="@style/HomeText" android:text="Sẵn sàng vận động?" android:textSize="20sp"
                        android:lineHeight="28sp" android:minHeight="28sp" android:textStyle="bold"/>
                    <TextView style="@style/HomeSmall" android:text="ghi lại buổi tập hôm nay" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/home_record" style="@style/ExPrimary"
                        android:text="Ghi nhận buổi tập" android:textSize="15sp" android:textStyle="normal" android:fontFamily="sans-serif-medium"
                        android:layout_height="56dp" android:layout_marginTop="8dp"
                        android:background="@drawable/home_primary"/>
                    <Space android:layout_width="1dp" android:layout_height="9dp"/>
                </LinearLayout>

                <TextView android:id="@+id/home_month" style="@style/HomeHeading" android:layout_marginTop="18dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/ex_surface">
                    <LinearLayout style="@style/HomeStatColumn">
                        <TextView android:id="@+id/home_workouts" style="@style/HomeNumber"/>
                        <TextView style="@style/HomeCaption" android:text="Buổi tập" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout style="@style/HomeStatColumn">
                        <TextView android:id="@+id/home_minutes" style="@style/HomeNumber"/>
                        <TextView style="@style/HomeCaption" android:text="Phút tập" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout style="@style/HomeStatColumn">
                        <TextView android:id="@+id/home_completed" style="@style/HomeNumber"/>
                        <TextView style="@style/HomeCaption" android:text="Lượt bài xong" android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:gravity="center_vertical">
                    <TextView style="@style/HomeHeading" android:text="Buổi tập gần nhất"
                        android:layout_width="0dp" android:layout_weight="1"/>
                    <TextView android:id="@+id/home_history" style="@style/HomeSmall" android:text="Xem tất cả →"
                        android:layout_width="wrap_content" android:textColor="?attr/exAccent"
                        android:clickable="true" android:focusable="true"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/home_recent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:padding="14dp" android:orientation="vertical" android:background="@drawable/ex_card"
                    android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/home_recent_date" style="@style/HomeText"
                        android:textSize="15sp" android:lineHeight="21sp" android:minHeight="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/home_recent_names" style="@style/HomeText" android:layout_marginTop="5dp"/>
                    <TextView android:id="@+id/home_recent_summary" style="@style/HomeCaption" android:layout_marginTop="5dp"/>
                    <TextView android:id="@+id/home_recent_detail" style="@style/HomeCaption" android:text="Chi tiết →"
                        android:textStyle="bold" android:gravity="end" android:textColor="?attr/exAccent"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:padding="16dp"
                    android:orientation="vertical" android:background="@drawable/ex_surface">
                    <TextView style="@style/HomeText" android:text="Nhắc nhở tập luyện" android:textSize="15sp"
                        android:lineHeight="21sp" android:minHeight="21sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/home_reminder_schedule" style="@style/HomeText" android:layout_marginTop="5dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp">
                        <TextView android:id="@+id/home_reminder_status" style="@style/HomeCaption"
                            android:layout_width="0dp" android:layout_weight="1"/>
                        <TextView android:id="@+id/home_reminder_edit" style="@style/HomeCaption" android:text="Chỉnh sửa →"
                            android:layout_width="wrap_content" android:textColor="?attr/exAccent"
                            android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ProgressBar android:id="@+id/home_loading" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="center"/>
        <LinearLayout android:id="@+id/home_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical"
            android:padding="24dp" android:background="?attr/exBackground" android:visibility="gone">
            <TextView android:id="@+id/home_error_text" style="@style/HomeText" android:gravity="center"/>
            <TextView android:id="@+id/home_retry" style="@style/ExPrimary" android:text="Thử tải lại dữ liệu" android:layout_marginTop="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/exercise_nav_xml"/>
    <View android:id="@+id/home_bottom_inset" android:layout_width="match_parent"
        android:layout_height="0dp" android:background="?attr/exSurface"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/select_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ex_card"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Thumbnail ảnh / Placeholder -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/ex_photo"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/select_item_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh minh họa bài tập" />

            <TextView
                android:id="@+id/select_item_thumb_placeholder"
                style="@style/ExText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="ẢNH"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/exMuted" />
        </FrameLayout>

        <!-- Thông tin tên bài và chi tiết số hiệp/lần -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/select_item_name"
                style="@style/ExText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chống đẩy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineHeight="22sp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="4dp" />

            <TextView
                android:id="@+id/select_item_details"
                style="@style/ExText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ngực · 3 hiệp × 12 lần"
                android:textSize="13sp"
                android:textColor="?attr/exMuted"
                android:lineHeight="18sp" />
        </LinearLayout>

        <!-- Icon chevron sang phải -->
        <TextView
            android:id="@+id/select_item_chevron"
            style="@style/ExText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="20sp"
            android:textColor="?attr/exMuted"
            android:paddingRight="4dp" />

    </LinearLayout>
</LinearLayout>

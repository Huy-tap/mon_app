<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="true">
<com.example.fitnessapp.xmlui.ZoomImageView android:id="@+id/ex_full_image" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/exOutline" android:contentDescription="Ảnh hướng dẫn"/>
<VideoView android:id="@+id/ex_player" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:visibility="gone"/>
<TextView android:id="@+id/ex_media_error" style="@style/ExText" android:text="Không đọc được ảnh hướng dẫn" android:layout_height="match_parent" android:gravity="center" android:visibility="gone"/>
</FrameLayout><TextView android:id="@+id/ex_media_caption" style="@style/ExText" android:text="" android:padding="12dp" android:textSize="13sp"/></LinearLayout>
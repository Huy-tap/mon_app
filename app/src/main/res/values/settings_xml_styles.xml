<?xml version="1.0" ?>
<resources>


    <attr name="settingsMuted" format="color"/>
    <attr name="settingsSelected" format="color"/>
    <attr name="settingsOnSelected" format="color"/>


    <style name="Theme.SettingsXml" parent="Theme.ExerciseXml">
        <item name="settingsMuted">#6B7280</item>
        <item name="settingsSelected">#EFF6FF</item>
        <item name="settingsOnSelected">#2563EB</item>
    </style>


    <style name="Theme.SettingsXml.Dark" parent="Theme.ExerciseXml.Dark">
        <item name="settingsMuted">#938F99</item>
        <item name="settingsSelected">#4F378B</item>
        <item name="settingsOnSelected">#E8DEF8</item>
    </style>


    <style name="SettingsText" parent="ExText">
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">18sp</item>
    </style>


    <style name="SettingsHeading" parent="SettingsText">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>
